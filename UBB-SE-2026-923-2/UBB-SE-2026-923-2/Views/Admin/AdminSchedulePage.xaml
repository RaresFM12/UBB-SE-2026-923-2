<Page
    x:Class="UBB_SE_2026_923_2.Views.Admin.AdminSchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UBB_SE_2026_923_2.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" ColumnSpacing="20" Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource AppSurfaceBrush}" 
                BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" 
                CornerRadius="12" Padding="20" VerticalAlignment="Top">
            <StackPanel Spacing="20">
                <TextBlock Text="Shift Roster" Foreground="{StaticResource AppAccentBrush}" 
                           FontSize="24" FontWeight="SemiBold"/>

                <TextBlock Text="View Mode" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Margin="0,0,0,-15"/>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="DailyBtn" Content="Daily" Grid.Column="0" HorizontalAlignment="Stretch" 
                                  IsChecked="True" Click="ViewMode_Click"/>
                    <ToggleButton x:Name="WeeklyBtn" Content="Weekly" Grid.Column="1" HorizontalAlignment="Stretch" 
                                  Click="ViewMode_Click"/>
                </Grid>

                <TextBlock Text="Select Department" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Margin="0,10,0,-15"/>
                <ComboBox x:Name="DepartmentFilterComboBox" 
                          PlaceholderText="All Departments" HorizontalAlignment="Stretch"
                          SelectionChanged="DepartmentFilterComboBox_SelectionChanged"
                          SelectedIndex="0">
                    <x:String>All Departments</x:String>
                    <x:String>ER</x:String>
                    <x:String>Ward A</x:String>
                    <x:String>Ward B</x:String>
                    <x:String>Cardiology</x:String>
                    <x:String>Surgery</x:String>
                    <x:String>Neurology</x:String>
                    <x:String>Pediatry</x:String>
                    <x:String>Oncology</x:String>
                    <x:String>Pharmacy</x:String>
                </ComboBox>

                <TextBlock Text="Select Date" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Margin="0,10,0,-15"/>
                <CalendarView x:Name="DateCalendar" 
                              SelectionMode="Single"
                              SelectedDatesChanged="DateCalendar_SelectedDatesChanged"
                              HorizontalAlignment="Stretch"/>

                <Button Content="Back to Creating Shifts"
                    Click="Back_Click"
                    Background="#0288D1"
                    HorizontalAlignment="Stretch"/>

                <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" 
              BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" 
              CornerRadius="12" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Bind AdminShiftViewModel.ScheduleTitle, Mode=OneWay}" 
                       Foreground="{StaticResource AppAccentBrush}" 
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <ListView Grid.Row="1" ItemsSource="{x:Bind AdminShiftViewModel.Shifts, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Shift">
                        <Grid Padding="15" Margin="0,0,0,10" Background="{StaticResource AppBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{x:Bind AppointedStaff.FirstName}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{x:Bind AppointedStaff.LastName}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Location}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{x:Bind StartTime}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="-" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind EndTime}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Status}" Foreground="#15803D" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="Set Active" Click="SetActive_Click" Tag="{x:Bind Id}" Background="#16A34A"/>
                                <Button Content="Cancel" Click="CancelShift_Click" Tag="{x:Bind Id}" Background="#DC2626"/>
                                <Button Content="Auto-Reassign" Click="AutoReassign_Click" Tag="{x:Bind}" Background="#0288D1"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>