<Page
    x:Class="UBB_SE_2026_923_2.Views.Orders.NonEditableOrderDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UBB_SE_2026_923_2.Views.Orders"
    xmlns:localModel="using:UBB_SE_2026_923_2.ViewModels.Orders"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20"
          ColumnDefinitions="*, Auto"
          Background="{StaticResource AppBackgroundBrush}">

        <ListView Grid.Row="0"
                  Grid.Column="0"
                  ItemsSource="{x:Bind ViewModel.OrderItems}">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="localModel:ItemDetail">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Image Grid.Row="0"
                               Grid.Column="0"
                               Source="{x:Bind ItemThumbnailImagePath, Mode=OneTime}"
                               Width="150"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{x:Bind ItemDescription, Mode=OneTime}"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{StaticResource AppTextPrimaryBrush}"/>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="10">

                            <TextBlock Text="{x:Bind ItemQuantityString, Mode=OneTime}"
                                       Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Text="{x:Bind ItemFinalPriceString, Mode=OneTime}"
                                       FontWeight="Bold" Foreground="{StaticResource AppErrorBrush}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView Grid.Row="0"
                  Grid.Column="1">

            <TextBlock Text="Total price:"
                       FontSize="15"
                       Foreground="{StaticResource AppTextSecondaryBrush}"/>
            <TextBlock Text="{x:Bind ViewModel.TotalPriceString}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource AppErrorBrush}"
                       Padding="15"/>

            <TextBlock Text="Order status:"
                       FontSize="15"
                       Foreground="{StaticResource AppTextSecondaryBrush}"/>
            <TextBlock Text="{x:Bind ViewModel.StatusString}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource AppTextPrimaryBrush}"
                       Padding="15"/>

            <TextBlock Text="Pick-up date:"
                       FontSize="15"
                       Foreground="{StaticResource AppTextSecondaryBrush}"/>
            <TextBlock Text="{x:Bind ViewModel.PickUpDateString}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource AppTextPrimaryBrush}"
                       Padding="15"/>
        </ListView>
    </Grid>
</Page>