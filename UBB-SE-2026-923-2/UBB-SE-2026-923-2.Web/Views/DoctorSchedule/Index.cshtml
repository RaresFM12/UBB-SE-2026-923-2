@model UBB_SE_2026_923_2.Web.Models.DoctorScheduleViewModel
@using UBB_SE_2026_923_2.Models

@{
    ViewData["Title"] = "Doctor Schedule";
    var doctors = ViewBag.Doctors as List<Doctor> ?? new List<Doctor>();
    var selectedDoctorId = ViewBag.SelectedDoctorId as int?;
}

<h2>Doctor Schedule</h2>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            @if (User.IsInRole("Admin"))
            {
                <div class="col-auto">
                    <label class="form-label">Select Doctor</label>
                    <select name="selectedDoctorId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Select doctor --</option>
                        @foreach (var doctor in doctors)
                        {
                            <option value="@doctor.StaffID" selected="@(selectedDoctorId == doctor.StaffID ? "selected" : null)">
                                @doctor.FirstName @doctor.LastName
                            </option>
                        }
                    </select>
                </div>
            }
            <div class="col-auto">
                <label for="startDate" class="form-label">Start Date</label>
                <input type="date" class="form-control" id="startDate" name="startDate" value="@ViewBag.StartDate">
            </div>
            <div class="col-auto">
                <label for="endDate" class="form-label">End Date</label>
                <input type="date" class="form-control" id="endDate" name="endDate" value="@ViewBag.EndDate">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>
</div>

@if (!selectedDoctorId.HasValue)
{
    <div class="alert alert-secondary">Select a doctor to see their schedule.</div>
}

@if (selectedDoctorId.HasValue)
{
    <h4>Upcoming Shifts</h4>
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Location</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Shifts.Any())
            {
                foreach (var shift in Model.Shifts)
                {
                    var badgeClass = shift.Status.ToString() == "SCHEDULED" ? "bg-primary" :
                                     shift.Status.ToString() == "ACTIVE" ? "bg-success" : "bg-secondary";
                    <tr>
                        <td>@shift.Location</td>
                        <td>@shift.StartTime.ToString("g")</td>
                        <td>@shift.EndTime.ToString("g")</td>
                        <td><span class="badge @badgeClass">@shift.Status</span></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-center">No shifts found for the selected date range.</td></tr>
            }
        </tbody>
    </table>

    <h4 class="mt-4">Upcoming Appointments</h4>
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Patient</th>
                <th>Date</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Appointments.Any())
            {
                foreach (var appointment in Model.Appointments)
                {
                    var badgeClass = appointment.Status.ToString() == "SCHEDULED" ? "bg-primary" :
                                     appointment.Status.ToString() == "ACTIVE" ? "bg-success" : "bg-secondary";
                    <tr>
                        <td>@appointment.PatientName</td>
                        <td>@appointment.Date.ToString("dd MMM yyyy")</td>
                        <td>@appointment.StartTime.ToString(@"hh\:mm")</td>
                        <td>@appointment.EndTime.ToString(@"hh\:mm")</td>
                        <td><span class="badge @badgeClass">@appointment.Status</span></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" class="text-center">No appointments found for the selected date range.</td></tr>
            }
        </tbody>
    </table>
}