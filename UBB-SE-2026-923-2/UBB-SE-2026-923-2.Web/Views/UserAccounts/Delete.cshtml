@model UBB_SE_2026_923_2.Web.ViewModels.UserAccountDeleteViewModel
@{
    ViewData["Title"] = "Disable account";
}

<h2 class="mb-3">Disable account</h2>

<div class="alert alert-warning">
    Disabling an account prevents sign-in but keeps historical data intact.
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Username) ? "(no username)" : Model.Username)</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "(no phone)" : Model.PhoneNumber)</dd>

            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">@Model.DisplayRole</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Disable account</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
