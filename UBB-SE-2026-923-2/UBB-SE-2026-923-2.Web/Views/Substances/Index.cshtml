@model List<Substance>
@{
    ViewData["Title"] = "Substances";
}

<h2 class="mb-4">Substances</h2>

<div class="mb-3">
    <a asp-controller="Substances" asp-action="Create" class="btn btn-primary">Add Substance</a>
    <a asp-controller="Items" asp-action="Index" class="btn btn-secondary ms-2">Back to Items</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No substances found.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Lethal Dose</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Substance substance in Model)
            {
                <tr>
                    <td>@substance.Name</td>
                    <td>@substance.LethalDose.ToString("F2")</td>
                    <td>@substance.Description</td>
                    <td>
                        <a asp-controller="Substances" asp-action="Edit" asp-route-name="@substance.Name" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-controller="Substances" asp-action="Delete" asp-route-name="@substance.Name" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
