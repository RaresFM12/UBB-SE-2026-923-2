@model OrdersIndexViewModel
@{
    ViewData["Title"] = "Order history";
}

<h2 class="mb-4">Your Orders</h2>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form asp-action="Index" method="get" class="mb-3">
    <div class="form-check">
        <input asp-for="ShowExpired" class="form-check-input" onchange="this.form.submit()" />
        <label asp-for="ShowExpired" class="form-check-label">Show expired orders</label>
    </div>
</form>

@if (!Model.Orders.Any())
{
    <div class="alert alert-info">No orders found.</div>
}
else
{
    <div class="row g-3">
        @foreach (OrderListItemViewModel order in Model.Orders)
        {
            string borderClass = order.IsExpired ? "border-danger" : "border-primary";
            string badgeClass = order.IsExpired ? "bg-danger" : order.IsCompleted ? "bg-success" : "bg-warning text-dark";

            <div class="col-12">
                <div class="card @borderClass">
                    <div class="card-body d-flex flex-wrap justify-content-between gap-3 align-items-center">
                        <div>
                            <h5 class="card-title mb-2">Order#@order.Id</h5>
                            <div class="text-muted">Pickup: @order.PickUpDateString</div>
                            <div class="text-muted">Expiration: @order.ExpirationDateString</div>
                            <span class="badge @badgeClass mt-2">@order.Status</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-secondary">Details</a>
                            @if (!order.IsCompleted && !order.IsExpired)
                            {
                                <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-outline-primary">Modify</a>
                                <a asp-action="Delete" asp-route-id="@order.Id" class="btn btn-outline-danger">Cancel Order</a>
                            }
                            @if (order.IsExpired)
                            {
                                <a asp-action="Resubmit" asp-route-id="@order.Id" class="btn btn-primary">Resubmit</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
