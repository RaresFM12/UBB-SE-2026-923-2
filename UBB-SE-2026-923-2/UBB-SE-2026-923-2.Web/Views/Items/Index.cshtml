@model ItemIndexViewModel
@{
    ViewData["Title"] = "Inventory";
}

<h2 class="mb-4">Inventory</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-controller="Items" asp-action="Create" class="btn btn-primary me-2">Add Item</a>
        <a asp-controller="Substances" asp-action="Index" class="btn btn-secondary me-2">Substances</a>
        <a asp-controller="Statistics" asp-action="Index" class="btn btn-info">Statistics</a>
    </div>
</div>

<form asp-controller="Items" asp-action="Index" method="get" class="mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by name..." />
        </div>
        <div class="col-auto">
            <div class="form-check">
                <input type="checkbox" name="showExpiredOnly" value="true" class="form-check-input" id="showExpiredOnly"
                       @(Model.ShowExpiredOnly ? "checked" : string.Empty) />
                <label class="form-check-label" for="showExpiredOnly">Expired only</label>
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Filter</button>
            <a asp-controller="Items" asp-action="Index" class="btn btn-outline-secondary ms-1">Reset</a>
        </div>
    </div>
</form>

@if (!Model.Items.Any())
{
    <p class="text-muted">No items found.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Producer</th>
                <th>Category</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Discount %</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Item item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Producer</td>
                    <td>@item.Category</td>
                    <td>@item.Price.ToString("F2")</td>
                    <td>@item.Quantity</td>
                    <td>@item.DiscountPercentage</td>
                    <td>
                        <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-controller="Items" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-controller="Items" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
