@model IEnumerable<UBB_SE_2026_923_2.Models.Shift>
@using UBB_SE_2026_923_2.Models

@{
    ViewData["Title"] = "My Pharmacy Schedule";
    var pharmacists = ViewBag.Pharmacists as List<Pharmacyst> ?? new List<Pharmacyst>();
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var selectedPharmacistId = ViewBag.SelectedPharmacistId as int?;
}

<h2>My Pharmacy Schedule</h2>

@if (isAdmin)
{
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Select Pharmacist</label>
                    <select name="selectedPharmacistId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Select pharmacist --</option>
                        @foreach (var p in pharmacists)
                        {
                            <option value="@p.StaffID" selected="@(selectedPharmacistId == p.StaffID ? "selected" : null)">
                                @p.FirstName @p.LastName
                            </option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(ViewBag.StatusMessage as string))
{
    <div class="alert alert-warning">@ViewBag.StatusMessage</div>
}

@if (!isAdmin || selectedPharmacistId.HasValue)
{
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                @if (selectedPharmacistId.HasValue)
                {
                    <input type="hidden" name="selectedPharmacistId" value="@selectedPharmacistId" />
                }
                <div class="col-auto">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" class="form-control" id="startDate" name="startDate" value="@ViewBag.StartDate">
                </div>
                <div class="col-auto">
                    <label for="endDate" class="form-label">End Date</label>
                    <input type="date" class="form-control" id="endDate" name="endDate" value="@ViewBag.EndDate">
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Location</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var shift in Model)
                {
                    var badgeClass = shift.Status.ToString() == "SCHEDULED" ? "bg-primary" :
                                     shift.Status.ToString() == "ACTIVE" ? "bg-success" : "bg-secondary";
                    <tr>
                        <td>@shift.Location</td>
                        <td>@shift.StartTime.ToString("g")</td>
                        <td>@shift.EndTime.ToString("g")</td>
                        <td><span class="badge @badgeClass">@shift.Status</span></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">No shifts found for the selected date range.</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-secondary">Select a pharmacist to see their schedule.</div>
}