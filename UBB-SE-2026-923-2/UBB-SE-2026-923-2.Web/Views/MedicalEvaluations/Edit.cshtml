@model UBB_SE_2026_923_2.Models.MedicalEvaluation
@{
    ViewData["Title"] = "Edit Evaluation";
}

<h2>Edit Evaluation #@Model.EvaluationID</h2>

<div class="card p-4 mt-3 col-md-8">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="EvaluationID" />
        <input type="hidden" asp-for="PatientId" />

        <div class="form-group mb-3">
            <label class="control-label fw-bold">Patient ID (Read-Only)</label>
            <input class="form-control" value="@Model.PatientId" disabled />
        </div>

        <div class="form-group mb-3">
            <label class="control-label fw-bold">Symptoms / Diagnosis</label>
            <textarea asp-for="Symptoms" class="form-control" rows="3"></textarea>
        </div>

        <div class="form-group mb-3">
            <label class="control-label fw-bold">Prescribed Medications</label>
            <input asp-for="MedicationsList" class="form-control" />
        </div>

        <div class="form-group mb-4">
            <label class="control-label fw-bold">Doctor Notes</label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-warning">Update Evaluation</button>
        <a asp-action="Index" asp-route-doctorId="@Model.Evaluator?.StaffID" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>