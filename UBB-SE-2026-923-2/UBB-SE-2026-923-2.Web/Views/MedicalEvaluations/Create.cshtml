@model UBB_SE_2026_923_2.Models.MedicalEvaluation
@{
    ViewData["Title"] = "New Evaluation";
    var doctorList = ViewBag.DoctorList as IEnumerable<UBB_SE_2026_923_2.Models.Doctor>;
    var wellnessItems = ViewBag.WellnessItems as IEnumerable<UBB_SE_2026_923_2.Models.Item>;
}

<h2>Create Medical Evaluation</h2>

<div class="row mt-4">
    <div class="col-md-7">
        <div class="card p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Doctor (Evaluator)</label>
                    <select name="Evaluator.StaffID" class="form-select" required>
                        <option value="">-- Select Doctor --</option>
                        @if (doctorList != null)
                        {
                            foreach (var doctor in doctorList)
                            {
                                <option value="@doctor.StaffID">@doctor.FirstName @doctor.LastName</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Patient ID</label>
                    <input asp-for="PatientId" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Symptoms / Diagnosis (Add '[RISK]' if high risk)</label>
                    <textarea asp-for="Symptoms" class="form-control" rows="3"></textarea>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Prescribed Medications (Comma separated)</label>
                    <input asp-for="MedicationsList" class="form-control" />
                </div>

                <div class="form-group mb-4">
                    <label class="control-label fw-bold">Doctor Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Save Evaluation</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Back</a>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card p-4 bg-light">
            <h4 class="text-success">Recommended Wellness Items</h4>
            <p class="text-muted small">Consider suggesting these to the patient during evaluation.</p>
            <ul class="list-group">
                @if (wellnessItems != null)
                {
                    foreach (var item in wellnessItems)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @item.Name
                            <span class="badge bg-success rounded-pill">$@item.Price</span>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</div>